# ---- Site ----
NODE_ENV=development
NEXT_PUBLIC_DOMAIN=slackactivity.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Turso (libSQL) ----
# turso db show <db> --url   /   turso db tokens create <db>
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# ---- Session ----
# Signs the auth cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this signs every user out.
SESSION_SECRET=

# ---- Slack app ----
# https://api.slack.com/apps — the redirect URIs must match EXACTLY.
NEXT_PUBLIC_SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NEXT_PUBLIC_SLACK_REDIRECT_URI=https://slackactivity.com/api/slack/token
NEXT_PUBLIC_SLACK_REDIRECT_URI_DEV=http://localhost:3000/api/slack/token

# ---- Google sign-in (optional; button hidden when unset) ----
# Authorized redirect URI: <site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email + password sign-in (optional; hidden when unset) ----
# Cloudflare Email Sending: token with "Email Sending: Edit", the account id,
# and a sender on a domain set up for Email Sending.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=welcome@slackactivity.com

# ---- Presence cron ----
# Call /api/slack/schleude?secret=... every ~5 minutes.
SLACK_SCHEDULE_SECRET=

# ---- Optional ----
# Incoming webhook for the contact form.
SLACK_WEBHOOK_URL=
# Comma-separated emails allowed to access /admin.
ADMIN_EMAILS=

# ---- Log retention (optional) ----
# Prune raw activity_logs rows older than N days, a bounded slice per cron tick.
# The rollup tables keep every aggregate the dashboards read, so nothing visible
# is lost. Unset or 0 keeps every row forever.
ACTIVITY_LOG_RETENTION_DAYS=

# ---- Growth Hub site adapter (optional) ----
# openssl rand -hex 32; same value in the hub under Connections > Site adapter.
GROWTH_HUB_SECRET=
